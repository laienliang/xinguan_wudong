# 测试环境变量配置示例
# 复制此文件为 .env.test 并修改相应的值

# 测试数据库配置
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=root
TEST_DB_PASSWORD=
TEST_DB_NAME=cool_test

# 说明：
# 1. 测试会使用独立的数据库 cool_test，不会影响开发数据库 cool
# 2. 测试环境会自动建表 (synchronize: true)
# 3. 如果数据库不存在，需要手动创建：
#    CREATE DATABASE cool_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
